class Solution:
    def minimumDistance(self, word: str) -> int:
        from functools import lru_cache
        
        # Convert letter to (row, col)
        def get_pos(c):
            idx = ord(c) - ord('A')
            return divmod(idx, 6)
        
        # Manhattan distance
        def dist(a, b):
            if a is None:
                return 0
            x1, y1 = a
            x2, y2 = b
            return abs(x1 - x2) + abs(y1 - y2)
        
        n = len(word)
        
        @lru_cache(None)
        def dp(i, f1, f2):
            if i == n:
                return 0
            
            cur = get_pos(word[i])
            
            # Move finger1
            cost1 = dist(f1, cur) + dp(i + 1, cur, f2)
            
            # Move finger2
            cost2 = dist(f2, cur) + dp(i + 1, f1, cur)
            
            return min(cost1, cost2)
        
        return dp(0, None, None)
