#include <bits/stdc++.h>
using namespace std;

class Solution {
public:
    int minFlips(string s) {
        int n = s.size(), ans = n, d1 = 0, d2 = 0;
        string t = s + s;

        for (int i = 0, j = 0; i < 2 * n; i++) {
            if (t[i] != (i % 2 ? '1' : '0')) d1++;
            if (t[i] != (i % 2 ? '0' : '1')) d2++;

            if (i - j + 1 > n) {
                if (t[j] != (j % 2 ? '1' : '0')) d1--;
                if (t[j] != (j % 2 ? '0' : '1')) d2--;
                j++;
            }

            if (i - j + 1 == n) ans = min(ans, min(d1, d2));
        }
        return ans;
    }
};
