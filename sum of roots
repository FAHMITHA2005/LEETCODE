class Solution:
    def sumRootToLeaf(self, root):
        
        def dfs(node, value):
            if node is None:
                return 0
            
            # Build binary number
            value = value * 2 + node.val
            
            # If leaf node
            if node.left is None and node.right is None:
                return value
            
            # Sum left and right
            return dfs(node.left, value) + dfs(node.right, value)
        
        return dfs(root, 0)
